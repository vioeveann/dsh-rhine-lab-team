{
  "name": "dsh-rhine-lab-team",
  "version": "0.5.2",
  "type": "module",
  "description": "给 DeepSeek Harness 配一个工作团队：每个 Bot 有自己的记忆、分工、头像和 ID；在你的指导下或自己干活，都能积累经验、升级成长，成为你最放心可靠的团队成员。灵感与 UI 参考《明日方舟》，与官方无关。",
  "license": "MIT",
  "author": "Vioeve ann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vioeveann/dsh-rhine-lab-team.git"
  },
  "homepage": "https://github.com/vioeveann/dsh-rhine-lab-team#readme",
  "bugs": {
    "url": "https://github.com/vioeveann/dsh-rhine-lab-team/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host",
    "templates",
    "docs/QUICKSTART.md",
    "docs/RELEASE.md",
    "docs/DETAIL.md",
    "docs/DSH-API.md",
    "docs/runtime-notes.md",
    "docs/screenshots",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3-0",
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "multi-agent",
    "team",
    "persona",
    "secretary"
  ],
  "dependencies": {
    "dsh-avatar-frame": "latest"
  }
}
